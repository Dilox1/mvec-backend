# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Public base URL for uploaded images (product photos, etc). Leave unset in
# development, it's inferred from the request. In production, set this to
# your API's public URL so image links are stable (e.g. behind a proxy/CDN).
# PUBLIC_UPLOAD_URL=https://api.yourdomain.com

# Database (MySQL via Prisma)
# Local dev example: mysql://root:password@localhost:3306/mvec
# After setting this, run: npx prisma generate && npx prisma migrate dev
DATABASE_URL=mysql://user:password@localhost:3306/mvec

# Security / JWT
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# Demo/seed accounts (created by `npm run seed`, alongside the admin above
# and 8 starter categories). Every one of the 4 people below gets an
# account in every role the system has (vendor, buyer, supplier, affiliate,
# delivery). Password is the same for all 20 demo accounts:
#   Vendors (real, deliverable emails):
#     thedebugger001@gmail.com      (Gourshant)
#     pacuiyo91@gmail.com           (Paccific)
#     naradaishimwe74@gmail.com     (Narada)
#     sharifbazimya17@gmail.com     (Sharif)
#   Buyers:     user1buyer@gmail.com     / user2buyer@gmail.com     / user3buyer@gmail.com     / user4buyer@gmail.com
#   Suppliers:  user1supplier@gmail.com  / user2supplier@gmail.com  / user3supplier@gmail.com  / user4supplier@gmail.com
#   Affiliates: user1affiliate@gmail.com / user2affiliate@gmail.com / user3affiliate@gmail.com / user4affiliate@gmail.com
#   Delivery:   user1delivery@gmail.com  / user2delivery@gmail.com  / user3delivery@gmail.com  / user4delivery@gmail.com
SEED_USER_PASSWORD=password

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration
# EMAIL_PROVIDER=sendgrid -> uses SendGrid's Web API (recommended for production)
# EMAIL_PROVIDER=smtp (default) -> Nodemailer via Gmail app password or custom SMTP
EMAIL_PROVIDER=smtp

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# Nodemailer / Gmail App Password (used when EMAIL_PROVIDER=smtp, the default)
# Create an "App Password" in your Google Account security settings, not your
# normal Gmail password. Used for password resets and order notifications.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM=your_email@gmail.com
# Optional: any custom SMTP host instead of Gmail
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# ── Phone OTP / SMS Gateway ─────────────────────────────────────────────────
# SMS_PROVIDER=log     -> prints the code to the server console (dev default)
# SMS_PROVIDER=generic -> sends through any HTTP SMS gateway configured below
SMS_PROVIDER=log
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=MVEC
SMS_FROM_NAME=MVEC
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ── Mobile Money (MTN MoMo / Airtel Money) Gateway ──────────────────────────
# In non-production the gateway runs in sandbox mode (simulated USSD push) and
# no real credentials are required. Set these in production to use a live API.
MOMO_GATEWAY_BASE_URL=
MOMO_GATEWAY_SUB_KEY=
MOMO_GATEWAY_AUTH=
MOMO_WEBHOOK_SECRET=change_me_momo_webhook_secret
AIRTEL_WEBHOOK_SECRET=change_me_airtel_webhook_secret

# ── K-Pay | Online Payment Gateway System Rwanda (Visa/Mastercard + MoMo) ───
# In non-production the gateway runs in sandbox mode (simulated checkout) and
# no real credentials are required. Set these in production for live charges.
KPAY_BASE_URL=
KPAY_MERCHANT_ID=
KPAY_API_KEY=
KPAY_CALLBACK_SECRET=change_me_kpay_webhook_secret
KPAY_WEBHOOK_URL=http://localhost:4000/api/webhooks/kpay
